# Deployment values for decomp.wtf. Copy to .env next to compose.yaml and edit.
# Nothing here is a secret; keep .env out of git anyway.
#
# COMPOSE_FILE_DIR=$(pwd)

# Hostnames the app should accept. The app refuses any Host header outside
# 127.0.0.1:<port> and localhost:<port> with 403 "bad host" (DNS-rebinding protection), so the
# name you publish — a Tailscale `serve` svc name, a reverse-proxy name — must be listed here,
# comma- or space-separated. Leave empty if you only ever open 127.0.0.1:6464 yourself.
DECOMP_ALLOWED_HOSTS=decomp.example.ts.net

# Where the games you own live, mounted read-only at /roms inside the container. The app imports
# by path, so it must be a path you can keep stable.
DECOMP_ROMS=/path/to/roms

# The app's whole home (install, projects, database, logs) as a directory on the host. A bind
# mount, not a named volume: /home/decomp is where ~/Decomp, ~/.local and the log live, and under
# /var/lib/docker/volumes/... nothing on the host can reach them.
DECOMP_DATA=/opt/selfhosted/data/decomp-wtf

# The checkout the image is built from: ".." when docker/ sits inside the checkout (as it does in
# this repository), or an absolute path.
DECOMP_CHECKOUT=..

# Pinned network subnet for this stack. Only needed when the host has consumed Docker's default
# pools (30+ stacks); a brand-new stack then fails with "all predefined address pools have been
# fully subnetted".
DECOMP_SUBNET=10.79.0.0/24

# Changes when the image contents change: the container's first start reinstalls the app from the
# image only when this differs from the marker recorded in the data directory. It is what makes a
# rebuild actually take effect (an unchanged value leaves the old install running).
DECOMP_INSTALL_ID=20261031-fork11
